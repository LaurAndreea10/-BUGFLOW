{
  "name": "Bugflow Mermaid Studio",
  "short_name": "Bugflow",
  "description": "A local-first visual Mermaid studio for building, reviewing, presenting, and exporting production diagrams.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0b1020",
  "theme_color": "#2864e6",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New diagram",
      "short_name": "New",
      "description": "Open BUGFLOW and create a new diagram",
      "url": "./#lab",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Flow Forge",
      "short_name": "Forge",
      "description": "Open the visual flow builder",
      "url": "./#visual-builder",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Open live editor",
      "short_name": "Editor",
      "description": "Edit Mermaid source with line-aware diagnostics",
      "url": "./#studio-editor",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Production tools",
      "short_name": "Tools",
      "description": "Analyze, compare, present, and share diagrams",
      "url": "./#pro-center",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "categories": [
    "productivity",
    "developer",
    "education"
  ],
  "lang": "en",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./#studio-editor",
      "accept": {
        "text/plain": [
          ".mmd",
          ".mermaid",
          ".md",
          ".txt"
        ]
      }
    }
  ]
}
